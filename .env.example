# Pantti auctions Finland: copy to .env and fill in. .env is never uploaded.

# Your private ntfy topic: the same name you subscribe to in the ntfy app.
# Make one with:  echo pantti-$(openssl rand -hex 5)
NTFY_TOPIC=

# Your limits for the four categories, in % of the lot's metal value at today's spot price.
#   <CATEGORY>_MAX_PCT    the most you bid: 5 = 5 % above, 0 = never above, -5 = 5 % below
#   <CATEGORY>_ALERT_PCT  optional: a lot is marked 🟢 only at or below this (default: the MAX)
# Not set: 0 % (never above the metal value). Allowed: -50 to 100.
GOLD_COINS_MAX_PCT=
SILVER_COINS_MAX_PCT=
JUNK_GOLD_MAX_PCT=
JUNK_GOLD_ALERT_PCT=
JUNK_SILVER_MAX_PCT=
JUNK_SILVER_ALERT_PCT=

# Optional. Default Europe/Helsinki.
# TZ=Europe/Helsinki
